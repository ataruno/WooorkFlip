<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Workspace Window"
    Width="800"
    Height="580"
    MinWidth="700"
    MinHeight="500"
    WindowStartupLocation="CenterScreen"
    Background="#F3F5F8"
    FontFamily="Segoe UI"
    FontSize="13">

    <Window.Resources>

        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                    <Setter Property="Background" Value="#808080"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#E8EDF5"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                    <Setter Property="Background" Value="#808080"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#DCE3ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#88b4f5"/>
                                <Setter Property="Foreground"
                                        Value="#0e2155"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#839bb8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="22">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">

            <StackPanel>
                <TextBlock Text="Workspace Window"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>

                <TextBlock Text="Manage your workspace"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"/>
            </StackPanel>

        </Grid>

        <!-- Main content -->
        <Grid x:Name="MainLayout" Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Workspace list -->
            <Grid Grid.Column="0" Margin="0,0,16,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="WORKSPACES"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,0,10"/>

                <TextBox x:Name="WorkspaceName"
                         Grid.Row="1"
                         Height="38"
                         Margin="0,0,0,12"
                         ToolTip="Workspace name"/>

                <ListBox x:Name="WorkspaceList"
                         Grid.Row="2"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                <Grid Grid.Row="3" Margin="0,14,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="SaveButton"
                            Grid.Row="0"
                            Content="Save"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,0,5"/>

                    <Button x:Name="LoadButton"
                            Grid.Row="1"
                            Content="Load"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,0,5"/>

                    <Button x:Name="DeleteButton"
                            Grid.Row="2"
                            Content="Delete"
                            Style="{StaticResource SecondaryButton}"/>

                </Grid>

            </Grid>

            <!-- Detail panel -->
            <Border x:Name="DetailPanel"
                    Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="18">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="WORKSPACE DETAILS"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,0,0,16"/>

                    <TextBlock x:Name="DetailName"
                               Grid.Row="1"
                               Text="No workspace selected"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="DetailCount"
                               Grid.Row="2"
                               Text="Windows: —"
                               Margin="0,10,0,0"
                               Foreground="{StaticResource MutedBrush}"/>

                    <TextBlock x:Name="DetailSaved"
                               Grid.Row="3"
                               Text="Saved: —"
                               Margin="0,4,0,14"
                               Foreground="{StaticResource MutedBrush}"/>

                    <TextBox x:Name="OutputBox"
                             Grid.Row="4"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Background="#F5F7FA"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="11"
                             Padding="10"/>

                </Grid>
            </Border>
        </Grid>
        <!-- Status -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Text="Ready"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="16"
                   Margin="0,14,0,0"/>
    </Grid>
</Window>
